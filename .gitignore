# ── Platforms this project does not target ───────────────
#
# Android only. The generated scaffolding for the other five platforms is
# untouched boilerplate that Flutter recreates on demand with
# `flutter create --platforms=…`, so it is noise in review and in the archive.
app/ios/
app/macos/
app/linux/
app/windows/
app/web/
